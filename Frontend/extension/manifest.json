{
  "manifest_version": 3,
  "name": "Website Security Scanner",
  "version": "1.0",
  "description": "Automatically scans websites for security threats using AI analysis",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://fade1e629530.ngrok-free.app/*",
    "https://9f44511275e8.ngrok-free.app/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Security Scanner"
  },
  "web_accessible_resources": [
    {
      "resources": ["securityData.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
